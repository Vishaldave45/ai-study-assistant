# ── App & Environment ──
APP_NAME="AI Study Assistant"
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# ── Database ──
# Local SQLite default: sqlite:///./dev.db
# PostgreSQL example: postgresql://crm_admin:admin123@127.0.0.1:5434/ai_study_assistant
DATABASE_URL=sqlite:///./dev.db

# ── Auth & JWT ──
JWT_SECRET_KEY=your-super-secret-jwt-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── LLM & AI Providers ──
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o

# ── Embeddings & Vector Store ──
EMBEDDING_PROVIDER=gemini
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./backend/app/rag/vectorstore/faiss_index

# ── Uploads & Storage ──
STORAGE_DIRECTORY=storage
UPLOAD_STORAGE_PATH=./backend/storage/uploads
MAX_UPLOAD_SIZE=20971520

